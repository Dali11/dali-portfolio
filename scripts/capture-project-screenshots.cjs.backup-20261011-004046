const { chromium } = require("playwright");
const fs = require("node:fs");
const path = require("node:path");

const outputDir = path.join(process.cwd(), "public/images/projects");

const projects = [
  {
    name: "Malawi Food Security Monitor",
    url: "https://frontend-seven-omega-94.vercel.app/",
    file: "malawi-food-security.png",
  },
  {
    name: "Akonzi Sofa Furniture",
    url: "https://akonzifurniture.com/",
    file: "akonzi-furniture.png",
  },
  {
    name: "Travel Lab Malawi",
    url: "https://travel-lab-theta.vercel.app/",
    file: "travel-lab.png",
  },
  {
    name: "MeepleMania Games",
    url: "https://meeple.brandfletch.com/",
    file: "meeplemania.png",
  },
  {
    name: "Brandfletch Dev Studio",
    url: "https://dev.brandfletch.com/",
    file: "brandfletch-studio.png",
  },
  {
    name: "Jonge Investments",
    url: "https://jonge-investment.vercel.app/",
    file: "jonge-investments.png",
  },
];

(async () => {
  fs.mkdirSync(outputDir, { recursive: true });

  const browser = await chromium.launch({ headless: true });
  const results = [];

  try {
    for (const project of projects) {
      const page = await browser.newPage({
        viewport: { width: 1440, height: 1000 },
        deviceScaleFactor: 1,
      });

      try {
        console.log(`\nCapturing: ${project.name}`);
        const response = await page.goto(project.url, {
          waitUntil: "domcontentloaded",
          timeout: 90000,
        });

        if (!response || !response.ok()) {
          throw new Error(
            `Website returned HTTP ${response ? response.status() : "no response"}`
          );
        }

        await page.waitForTimeout(4500);

        await page.screenshot({
          path: path.join(outputDir, project.file),
          type: "png",
          fullPage: false,
          animations: "disabled",
        });

        console.log(`Saved: public/images/projects/${project.file}`);
        results.push({ ...project, success: true });
      } catch (error) {
        console.error(`FAILED: ${project.name}: ${error.message}`);
        results.push({
          ...project,
          success: false,
          error: error.message,
        });
      } finally {
        await page.close();
      }
    }
  } finally {
    await browser.close();
  }

  console.log("\n===== SCREENSHOT RESULTS =====");
  for (const result of results) {
    console.log(
      `${result.success ? "PASS" : "FAIL"}  ${result.name}` +
      (result.success ? ` -> ${result.file}` : ` -> ${result.error}`)
    );
  }

  const failed = results.filter((result) => !result.success).length;
  console.log(`\nCaptured ${results.length - failed}/${results.length} screenshots.`);

  if (failed) process.exitCode = 1;
})();
