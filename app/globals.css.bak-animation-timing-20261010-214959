/* ===== DALITSO-ANIMATION-V1 ===== */

/* Scroll reveals */
.reveal-on-scroll {
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity .7s cubic-bezier(.2,.7,.2,1),
    transform .7s cubic-bezier(.2,.7,.2,1);
  transition-delay: var(--reveal-delay, 0ms);
}

.reveal-on-scroll.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* Hero introduction */
.hero-copy > .eyebrow {
  animation: dalitso-fade-up .65s .08s both;
}

.hero-copy h1 {
  animation: dalitso-fade-up .8s .16s both;
}

.hero-copy .hero-description {
  animation: dalitso-fade-up .7s .28s both;
}

.hero-copy .hero-actions {
  animation: dalitso-fade-up .7s .38s both;
}

.hero-copy .availability {
  animation: dalitso-fade-up .7s .48s both;
}

.hero-art {
  animation: dalitso-art-enter .9s .12s both;
}

.hero-stat {
  animation: dalitso-stat-enter .7s .65s both;
}

/* Gentle decorative motion */
.brush-lime {
  animation: dalitso-float 7s ease-in-out infinite;
}

.brush-coral {
  animation: dalitso-float 9s ease-in-out -2s infinite;
}

.brush-lavender {
  animation: dalitso-float 8s ease-in-out -4s infinite;
}

.scribble-one {
  animation: dalitso-scribble 5s ease-in-out infinite;
}

/* Stagger project cards */
.project-card:nth-child(2) {
  --reveal-delay: 90ms;
}

.project-card:nth-child(3) {
  --reveal-delay: 180ms;
}

.project-card:nth-child(4) {
  --reveal-delay: 270ms;
}

/* Interactive polish */
@media (hover: hover) and (pointer: fine) {
  .project-card:hover .project-visual img {
    transform: scale(1.055);
  }

  .project-card:hover .visual-label {
    transform: translateY(-2px);
  }

  .hero-art:hover .hero-portrait {
    filter: saturate(1.04);
  }

  .service-item:hover .service-icon {
    transform: translateY(-3px) rotate(-4deg);
  }
}

.visual-label {
  transition: transform .25s ease;
}

@keyframes dalitso-fade-up {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes dalitso-art-enter {
  from {
    opacity: 0;
    transform: translateY(18px) scale(.975);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes dalitso-stat-enter {
  from {
    opacity: 0;
    transform: translate(12px, 8px);
  }
  to {
    opacity: 1;
    transform: translate(0, 0);
  }
}

@keyframes dalitso-float {
  0%, 100% {
    translate: 0 0;
  }
  50% {
    translate: 0 -8px;
  }
}

@keyframes dalitso-scribble {
  0%, 100% {
    translate: 0 0;
    rotate: 0deg;
  }
  50% {
    translate: 3px -4px;
    rotate: 5deg;
  }
}

/* Prevent motion for users who request it */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }

  .reveal-on-scroll {
    opacity: 1 !important;
    transform: none !important;
  }
}

