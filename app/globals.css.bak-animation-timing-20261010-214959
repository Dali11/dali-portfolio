@import "tailwindcss";

:root {
  --paper: #f7f5ee;
  --ink: #171815;
  --muted: #65655f;
  --line: #dedbd1;
  --lime: #d7ff67;
  --mint: #d8f1df;
  --coral: #ffd0c4;
  --lavender: #eadcff;
  --yellow: #ffe7a0;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 90px; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: Arial, Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
button, a { -webkit-tap-highlight-color: transparent; }
a:focus-visible, button:focus-visible { outline: 3px solid #587d00; outline-offset: 4px; }
::selection { background: var(--lime); color: var(--ink); }
.section-wrap { width: min(1320px, calc(100% - 88px)); margin-inline: auto; }

.site-header {
  width: min(1320px, calc(100% - 88px));
  min-height: 82px;
  margin-inline: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 20;
}
.wordmark { font-size: 29px; font-weight: 900; letter-spacing: -1.8px; line-height: 1; }
.wordmark span { color: #b6e832; }
.desktop-nav { display: flex; gap: clamp(22px, 3vw, 42px); align-items: center; }
.desktop-nav a { font-size: 13px; color: #45453f; transition: color .2s ease; }
.desktop-nav a:hover { color: #000; }
.header-cta { display: inline-flex; align-items: center; gap: 14px; padding: 13px 18px; border-radius: 999px; background: var(--ink); color: white; font-size: 12px; font-weight: 700; }
.menu-toggle, .mobile-nav { display: none; }

.hero { min-height: 510px; display: grid; grid-template-columns: 1.02fr .98fr; align-items: center; gap: 12px; padding-top: 18px; padding-bottom: 34px; }
.hero-copy { position: relative; z-index: 2; padding: 26px 0 20px; }
.eyebrow { margin: 0 0 18px; font-size: 10px; font-weight: 700; letter-spacing: 1.65px; text-transform: uppercase; color: #55554e; }
.hero .eyebrow { display: flex; align-items: center; gap: 9px; }
.eyebrow-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #b5e32d; }
.hero h1 { max-width: 720px; margin: 0; font-size: clamp(50px, 6.1vw, 88px); line-height: .91; letter-spacing: -.075em; font-weight: 900; }
.headline-highlight { display: table; position: relative; z-index: 0; margin-top: 4px; font-family: Georgia, "Times New Roman", serif; font-style: italic; font-weight: 700; letter-spacing: -.065em; }
.headline-highlight::before { content: ""; position: absolute; height: 31%; left: -3%; right: -2%; bottom: 7%; background: var(--lime); transform: rotate(-2.5deg); z-index: -1; border-radius: 5px; }
.hero-description { max-width: 500px; margin: 26px 0 22px; color: #45453f; font-size: clamp(15px, 1.4vw, 19px); line-height: 1.55; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.button { min-height: 46px; display: inline-flex; align-items: center; justify-content: center; gap: 14px; padding: 0 21px; border-radius: 999px; font-size: 12px; font-weight: 700; transition: transform .2s ease, background .2s ease; }
.button:hover { transform: translateY(-2px); }
.button-dark { background: var(--ink); color: white; }
.button-light { border: 1px solid #c8c5bc; background: transparent; }
.availability { margin-top: 21px; display: flex; align-items: center; flex-wrap: wrap; gap: 10px; color: #62625b; font-size: 11px; }
.availability-dot { width: 8px; height: 8px; border-radius: 50%; background: #9acb24; box-shadow: 0 0 0 3px #e8f4c7; }
.availability i { height: 3px; width: 3px; border-radius: 50%; background: #8e8c84; }

.hero-art { height: 470px; position: relative; isolation: isolate; align-self: stretch; }
.brush { position: absolute; z-index: -2; transform: rotate(-25deg); border-radius: 43% 57% 62% 38% / 44% 35% 65% 56%; }
.brush-lime { background: var(--lime); width: 75%; height: 76%; top: 3%; left: 5%; }
.brush-coral { background: #ff9d8a; width: 64%; height: 57%; top: 13%; right: 1%; transform: rotate(-39deg); mix-blend-mode: multiply; }
.brush-lavender { background: #c9a7ff; width: 60%; height: 45%; bottom: 3%; right: 0; transform: rotate(-20deg); mix-blend-mode: multiply; }
.hero-portrait { object-fit: contain; object-position: center bottom; z-index: -1; filter: saturate(.96); }
.art-note { position: absolute; left: 13%; top: 34%; font-size: 12px; line-height: 1.5; font-weight: 900; letter-spacing: 1px; transform: rotate(-8deg); }
.scribble { position: absolute; font-size: 58px; line-height: 1; font-weight: 300; transform: rotate(24deg); }
.scribble-one { top: 3%; left: 14%; }
.hero-stat { position: absolute; right: 0; top: 40%; display: grid; gap: 14px; padding: 18px 17px; border: 1px solid #fff; border-radius: 17px; background: rgba(255,255,255,.88); box-shadow: 0 12px 35px #2823190d; backdrop-filter: blur(8px); }
.hero-stat div { display: grid; gap: 2px; }
.hero-stat strong { font-size: 22px; letter-spacing: -1px; }
.hero-stat span { font-size: 10px; color: #62625b; }

.work-section { padding-top: 30px; padding-bottom: 58px; }
.section-heading { display: grid; grid-template-columns: 1fr 1fr auto; align-items: end; gap: 28px; margin-bottom: 28px; }
.section-heading .eyebrow, .services-heading .eyebrow, .about-copy .eyebrow { margin-bottom: 12px; }
.section-heading h2, .services-heading h2, .about-copy h2 { margin: 0; font-size: clamp(38px, 4.1vw, 58px); line-height: .91; letter-spacing: -.07em; font-weight: 900; }
.heading-break { display: none; }
.lime-period { color: #c1ee41; }
.section-intro { max-width: 340px; margin: 0 0 4px; color: var(--muted); font-size: 14px; line-height: 1.55; }
.view-all { margin-bottom: 2px; white-space: nowrap; }
.project-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 13px; }
.project-card { min-width: 0; padding: 12px; border-radius: 12px; display: flex; flex-direction: column; align-items: flex-start; }
.project-card.mint { background: var(--mint); }
.project-card.coral { background: var(--coral); }
.project-card.lavender { background: var(--lavender); }
.project-card.yellow { background: var(--yellow); }
.project-visual { width: 100%; position: relative; aspect-ratio: 1.42; overflow: hidden; border-radius: 8px; background: #ffffffa8; }
.project-visual img { object-fit: cover; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
.project-card:hover .project-visual img { transform: scale(1.035); }
.visual-label { position: absolute; left: 9px; top: 9px; z-index: 2; padding: 5px 7px; border-radius: 99px; background: #fff; color: #333; font-size: 8px; font-weight: 700; }
.project-meta { display: flex; align-items: center; gap: 11px; margin-top: 13px; }
.project-number { font-size: 22px; font-weight: 900; letter-spacing: -1px; }
.project-category { font-size: 8px; font-weight: 700; letter-spacing: .3px; }
.project-card h3 { margin: 7px 0 7px; font-size: clamp(16px, 1.45vw, 20px); line-height: 1.1; letter-spacing: -.7px; }
.project-card p { margin: 0 0 13px; color: #4d4b46; font-size: 12px; line-height: 1.45; }
.text-link { display: inline-flex; align-items: center; gap: 8px; margin-top: auto; font-size: 12px; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
.text-link svg { transition: transform .2s ease; }
.text-link:hover svg { transform: translate(2px,-2px); }

.services-section { padding-top: 12px; padding-bottom: 58px; display: grid; grid-template-columns: .95fr 2.05fr; gap: 38px; align-items: start; }
.services-heading h2 { font-size: clamp(37px, 3.7vw, 52px); }
.services-heading > p:last-child { max-width: 290px; margin: 17px 0 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
.services-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; padding-top: 3px; }
.service-icon { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 13px; margin-bottom: 14px; }
.service-icon.mint { background: var(--mint); }
.service-icon.coral { background: #ffb4a4; }
.service-icon.lavender { background: var(--lavender); }
.service-icon.yellow { background: var(--yellow); }
.service-item h3 { max-width: 150px; margin: 0 0 8px; font-size: 14px; line-height: 1.15; letter-spacing: -.35px; }
.service-item p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.5; }

.about-section { display: grid; grid-template-columns: .8fr 1.3fr .8fr; align-items: center; gap: 34px; padding-top: 30px; padding-bottom: 34px; border-top: 1px solid var(--line); }
.about-art { min-height: 230px; position: relative; overflow: hidden; isolation: isolate; }
.about-art img { object-fit: contain; object-position: center bottom; filter: grayscale(1); z-index: -1; }
.about-brush { position: absolute; z-index: -2; right: 0; bottom: 10%; width: 80%; height: 40%; background: var(--lime); transform: rotate(-16deg); border-radius: 50%; }
.about-art p { position: absolute; top: 12%; left: 0; font-family: Georgia, serif; font-style: italic; font-weight: 700; font-size: 18px; line-height: 1.1; transform: rotate(-8deg); }
.about-copy h2 { font-size: clamp(30px, 3vw, 43px); }
.about-copy > p:not(.eyebrow) { max-width: 530px; margin: 14px 0 17px; color: var(--muted); font-size: 13px; line-height: 1.65; }
.tools-panel { align-self: stretch; border-left: 1px solid var(--line); padding: 12px 0 12px 25px; }
.tools-title { margin: 0 0 17px; font-size: 12px; font-weight: 700; }
.tools-list { display: grid; grid-template-columns: 1fr 1fr; gap: 13px 14px; }
.tools-list span { font-size: 11px; color: #56564f; }

.contact-section { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: space-between; gap: 25px; padding: 38px 42px; border-radius: 17px; background: #1d1e1a; color: white; }
.contact-copy { position: relative; z-index: 1; max-width: 700px; }
.contact-copy .eyebrow { color: #e5e5dc; margin-bottom: 11px; }
.contact-copy h2 { margin: 0; font-size: clamp(37px, 4.5vw, 64px); letter-spacing: -.065em; line-height: .98; }
.contact-copy h2 span { color: var(--lime); }
.contact-copy > p:last-child { max-width: 540px; margin: 13px 0 0; color: #c8c8bf; font-size: 13px; line-height: 1.55; }
.contact-actions { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; min-width: 190px; }
.button-lime { background: var(--lime); color: var(--ink); }
.social-links { display: flex; gap: 8px; }
.social-links a { width: 39px; height: 39px; display: grid; place-items: center; border: 1px solid #6a6a61; border-radius: 10px; transition: background .2s ease, color .2s ease; }
.social-links a:hover { background: white; color: var(--ink); }
.social-links svg { width: 17px; height: 17px; }
.contact-brush { position: absolute; left: -20px; bottom: -38px; display: flex; gap: 0; transform: rotate(-22deg); opacity: .95; }
.contact-brush span { width: 35px; height: 140px; background: #baf5c7; }
.contact-brush span + span { background: #ff9d8a; transform: rotate(18deg); }
.site-footer { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
.site-footer .wordmark { font-size: 23px; }
.site-footer p, .back-top { color: var(--muted); font-size: 11px; }
.back-top { font-weight: 700; }

@media (min-width: 1500px) {
  .hero h1 { font-size: 90px; }
  .hero { min-height: 550px; }
  .hero-art { height: 510px; }
}
@media (max-width: 1100px) {
  .section-wrap, .site-header { width: min(100% - 52px, 1320px); }
  .hero { min-height: 460px; }
  .hero h1 { font-size: clamp(48px, 6.2vw, 70px); }
  .hero-art { height: 420px; }
  .hero-stat { right: -2px; padding: 13px; }
  .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .project-card h3 { font-size: 21px; }
  .project-card p { font-size: 13px; }
  .services-section { grid-template-columns: 1fr; gap: 25px; }
  .services-grid { gap: 24px; }
  .about-section { grid-template-columns: .8fr 1.2fr; }
  .tools-panel { grid-column: 2; border-left: 0; border-top: 1px solid var(--line); padding: 20px 0 0; }
  .tools-list { grid-template-columns: repeat(4, 1fr); }
}
@media (max-width: 760px) {
  html { scroll-padding-top: 72px; }
  .section-wrap, .site-header { width: calc(100% - 36px); }
  .site-header { min-height: 72px; }
  .wordmark { font-size: 27px; }
  .desktop-nav, .header-cta { display: none; }
  .menu-toggle { display: grid; place-items: center; border: 0; background: transparent; color: var(--ink); padding: 8px 0 8px 8px; cursor: pointer; }
  .mobile-nav { position: absolute; display: grid; top: 62px; left: 0; right: 0; padding: 10px 16px; background: #fffdf8; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 20px 45px #24221a18; }
  .mobile-nav a { display: flex; justify-content: space-between; align-items: center; min-height: 48px; border-bottom: 1px solid #ece9df; font-size: 15px; font-weight: 700; }
  .mobile-nav a:last-child { border-bottom: 0; }
  .hero { display: flex; flex-direction: column; align-items: stretch; gap: 0; padding-top: 23px; padding-bottom: 28px; }
  .hero-copy { padding: 0; }
  .hero .eyebrow { margin-bottom: 16px; font-size: 9px; }
  .hero h1 { max-width: 560px; font-size: clamp(43px, 11.8vw, 67px); line-height: .94; letter-spacing: -.075em; }
  .desktop-break { display: none; }
  .headline-highlight { margin-top: 2px; }
  .hero-description { max-width: 500px; margin: 19px 0 17px; font-size: 15px; line-height: 1.55; }
  .hero-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
  .button { min-height: 46px; padding: 0 12px; gap: 8px; font-size: 11px; }
  .availability { margin-top: 16px; gap: 8px; font-size: 10px; }
  .hero-art { height: clamp(300px, 94vw, 430px); margin: 7px -5px 0; overflow: hidden; }
  .brush-lime { width: 82%; height: 77%; top: 3%; left: 1%; }
  .brush-coral { width: 70%; height: 57%; top: 13%; right: -1%; }
  .brush-lavender { width: 68%; height: 43%; bottom: 2%; right: -2%; }
  .hero-portrait { object-position: center bottom; }
  .art-note { left: 5%; top: 29%; font-size: 10px; }
  .scribble-one { top: 1%; left: 12%; font-size: 45px; }
  .hero-stat { top: 12%; right: 1%; gap: 10px; padding: 12px 10px; border-radius: 12px; }
  .hero-stat strong { font-size: 18px; }
  .hero-stat span { max-width: 78px; font-size: 9px; }
  .work-section { padding-top: 28px; padding-bottom: 42px; }
  .section-heading { grid-template-columns: 1fr; align-items: start; gap: 13px; margin-bottom: 20px; }
  .section-heading .eyebrow { margin-bottom: 12px; }
  .section-heading h2 { font-size: clamp(42px, 11vw, 58px); }
  .heading-break { display: none; }
  .section-intro { max-width: 360px; margin: 0; font-size: 13px; }
  .view-all { justify-self: start; margin-top: 2px; }
  .project-grid { grid-template-columns: 1fr; gap: 13px; }
  .project-card { padding: 12px; border-radius: 13px; }
  .project-visual { aspect-ratio: 1.55; }
  .project-meta { margin-top: 12px; }
  .project-card h3 { font-size: 22px; }
  .project-card p { font-size: 13px; line-height: 1.5; max-width: 450px; }
  .text-link { min-height: 30px; }
  .services-section { padding-top: 7px; padding-bottom: 40px; gap: 24px; }
  .services-heading h2 { font-size: clamp(40px, 10vw, 53px); }
  .services-heading > p:last-child { margin-top: 12px; font-size: 13px; }
  .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 25px 18px; }
  .service-icon { width: 44px; height: 44px; margin-bottom: 11px; }
  .service-item h3 { font-size: 14px; }
  .service-item p { font-size: 12px; }
  .about-section { grid-template-columns: 1fr; gap: 18px; padding-top: 24px; padding-bottom: 28px; }
  .about-art { min-height: 270px; width: 100%; max-width: 420px; margin-inline: auto; }
  .about-art p { left: 5px; top: 9%; }
  .about-copy h2 { font-size: 39px; }
  .about-copy > p:not(.eyebrow) { font-size: 13px; }
  .tools-panel { grid-column: auto; border-top: 1px solid var(--line); padding-top: 19px; }
  .tools-list { grid-template-columns: repeat(2, 1fr); gap: 13px; }
  .contact-section { width: calc(100% - 20px); flex-direction: column; align-items: flex-start; gap: 23px; padding: 29px 24px 28px 28px; border-radius: 15px; }
  .contact-copy h2 { font-size: clamp(39px, 10vw, 55px); }
  .contact-copy > p:last-child { font-size: 12px; }
  .contact-actions { width: 100%; flex-direction: row; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; }
  .social-links { gap: 6px; }
  .social-links a { width: 36px; height: 36px; }
  .site-footer { min-height: 76px; flex-wrap: wrap; padding-top: 16px; padding-bottom: 16px; gap: 10px; }
  .site-footer p { order: 3; width: 100%; margin: 0; }
}
@media (max-width: 380px) {
  .section-wrap, .site-header { width: calc(100% - 28px); }
  .hero h1 { font-size: 42px; }
  .hero-actions { grid-template-columns: 1fr; }
  .hero-actions .button { width: 100%; }
  .hero-art { height: 300px; }
  .hero-stat { padding: 9px; }
  .hero-stat span { max-width: 68px; }
  .contact-section { padding-inline: 21px; }
  .contact-actions { align-items: flex-start; flex-direction: column; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}

/* ===== DALITSO-POLISH-V1 ===== */

/* Smoother interactions and refined visual rhythm */
html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
}

body {
  overflow-x: clip;
  text-rendering: optimizeLegibility;
}

::selection {
  background: var(--lime);
  color: var(--ink);
}

/* Refined sticky navigation */
.site-header {
  position: sticky;
  top: 0;
  width: 100%;
  min-height: 78px;
  padding-inline: max(44px, calc((100% - 1320px) / 2));
  background: rgb(247 245 238 / 88%);
  border-bottom: 1px solid transparent;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition: border-color .25s ease, background .25s ease;
}

.wordmark {
  font-size: 30px;
  letter-spacing: -2px;
  transition: opacity .2s ease;
}

.wordmark:hover {
  opacity: .72;
}

.desktop-nav a {
  position: relative;
  padding-block: 8px;
  font-weight: 500;
}

.desktop-nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 1px;
  width: 100%;
  height: 2px;
  background: var(--lime);
  transform: scaleX(0);
  transform-origin: right;
  transition: transform .25s ease;
}

.desktop-nav a:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

.header-cta,
.button {
  transition:
    transform .22s ease,
    background .22s ease,
    color .22s ease,
    box-shadow .22s ease;
}

.header-cta:hover,
.button-dark:hover {
  background: #30312a;
  box-shadow: 0 7px 20px rgb(23 24 21 / 12%);
}

.header-cta:hover {
  transform: translateY(-2px);
}

.button-light:hover {
  background: white;
  border-color: var(--ink);
}

.button-lime:hover {
  background: #e4ff91;
  transform: translateY(-2px);
}

/* Stronger hero composition */
.hero {
  padding-top: 26px;
  padding-bottom: 48px;
}

.hero-copy {
  padding-block: 30px;
}

.hero .eyebrow {
  letter-spacing: 1.8px;
}

.hero h1 {
  font-size: clamp(54px, 6.15vw, 86px);
  line-height: .94;
  letter-spacing: -.078em;
  text-wrap: balance;
}

.headline-highlight {
  padding-right: 5px;
}

.headline-highlight::before {
  height: 24%;
  bottom: 9%;
  border-radius: 4px;
}

.hero-description {
  max-width: 480px;
  line-height: 1.7;
}

.hero-art {
  overflow: visible;
}

.hero-portrait {
  transition: filter .35s ease;
}

.hero-stat {
  border-color: rgb(255 255 255 / 80%);
  box-shadow: 0 18px 50px rgb(23 24 21 / 9%);
  transition: transform .3s ease, box-shadow .3s ease;
}

.hero-stat:hover {
  transform: translateY(-4px);
  box-shadow: 0 24px 55px rgb(23 24 21 / 13%);
}

/* Section headings */
.work-section {
  padding-top: 42px;
  padding-bottom: 76px;
}

.section-heading {
  margin-bottom: 34px;
}

.section-heading h2,
.services-heading h2,
.about-copy h2 {
  text-wrap: balance;
}

.section-intro {
  line-height: 1.8;
}

/* More tactile project cards */
.project-grid {
  gap: 16px;
}

.project-card {
  position: relative;
  padding: 14px;
  border: 1px solid rgb(23 24 21 / 4%);
  border-radius: 15px;
  transition:
    transform .28s ease,
    box-shadow .28s ease,
    border-color .28s ease;
}

.project-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 18px 38px rgb(23 24 21 / 9%);
  border-color: rgb(23 24 21 / 9%);
}

.project-visual {
  border-radius: 10px;
  background: rgb(255 255 255 / 70%);
}

.project-visual img {
  transition: transform .65s cubic-bezier(.2, .7, .2, 1);
}

.project-card:hover .project-visual img {
  transform: scale(1.055);
}

.visual-label {
  padding: 6px 9px;
  font-size: 9px;
  box-shadow: 0 2px 8px rgb(0 0 0 / 5%);
}

.project-number {
  font-variant-numeric: tabular-nums;
}

.project-card h3 {
  line-height: 1.18;
  text-wrap: balance;
}

.project-card p {
  line-height: 1.65;
}

