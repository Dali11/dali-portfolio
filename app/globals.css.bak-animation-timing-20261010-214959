  animation: forward-eraser 2.2s ease-in-out 1.1s both;
}

@keyframes forward-eraser {
  0%, 43% {
    left: -3%;
    opacity: 0;
    transform: rotate(-12deg);
  }

  46% {
    left: 45%;
    opacity: 1;
    transform: rotate(-12deg);
  }

  70% {
    left: -3%;
    opacity: 1;
    transform: rotate(-12deg);
  }

  73%, 100% {
    left: -3%;
    opacity: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
