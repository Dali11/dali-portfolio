  .headline-highlight::after {
    animation: none !important;
    opacity: 0 !important;
    transform: none !important;
  }
}


/* ===== DALITSO PAINT MISTAKE → ERASER → FINAL HIGHLIGHT ===== */

/* The original, neat lime highlight remains underneath everything. */
.headline-highlight {
  isolation: isolate;
}

.headline-highlight::before {
  content: "";
  position: absolute;
  z-index: -1;
  height: 31%;
  left: -3%;
  right: -2%;
  bottom: 7%;
  border-radius: 5px;
  background: var(--lime);
  transform: rotate(-2.5deg);
  transform-origin: left center;
  animation: none;
}

/* A second stroke deliberately overshoots the word. */
.headline-highlight::after {
  content: "";
  position: absolute;
  z-index: 1;
  pointer-events: none;
  height: 31%;
  left: -3%;
  bottom: 7%;
  width: calc(100% + 42vw);
  min-width: 160%;
  border-radius: 5px 2px 4px 3px;
  background: var(--lime);
  transform: rotate(-2.5deg) scaleX(0);
  transform-origin: left center;
  clip-path: inset(0);
  animation: dalitso-paint-mistake 2.8s cubic-bezier(.22,.75,.25,1) 1s both;
}

@keyframes dalitso-paint-mistake {
  /* Start clean */
  0%, 8% {
    transform: rotate(-2.5deg) scaleX(0);
    clip-path: inset(0);
  }

  /* Brush paints across forward and keeps going */
  32% {
    transform: rotate(-2.5deg) scaleX(1);
    clip-path: inset(0);
  }

  /* Hold the obvious overshoot for a comic beat */
  43%, 49% {
    transform: rotate(-2.5deg) scaleX(1);
    clip-path: inset(0);
  }

  /* Eraser removes the excess from the far right, moving backwards */
  75% {
    transform: rotate(-2.5deg) scaleX(1);
    clip-path: inset(0 100% 0 0);
  }

  /* Remove the temporary layer; reveal the original neat stroke */
  76%, 100% {
    transform: rotate(-2.5deg) scaleX(1);
    clip-path: inset(0 100% 0 0);
  }
}

/* The small eraser follows the retreating edge of the oversized stroke. */
.headline-highlight {
  --eraser-size: 15px;
}

@media (min-width: 761px) {
  .headline-highlight::after {
    width: calc(100% + 32vw);
  }
}

/* Respect reduced motion: show the final, tidy design immediately. */
@media (prefers-reduced-motion: reduce) {
  .headline-highlight::after {
    animation: none !important;
    display: none;
  }
}

/* ===== FORWARD PAINT OVERSHOOT + VISIBLE ERASER ===== */
.headline-highlight {
  position: relative;
  display: inline-block;
  isolation: isolate;
  white-space: nowrap;
}

/* Keep the intended final highlight permanently underneath. */
.headline-highlight::before {
  z-index: -2 !important;
  transform: rotate(-2.5deg) !important;
  opacity: 1 !important;
  animation: none !important;
}

/* Oversized temporary paint stroke. */
.forward-paint-mistake {
  position: absolute;
  z-index: -1;
  pointer-events: none;
  left: -2%;
  bottom: 7%;
  width: calc(100% + 42vw);
  height: 31%;
  border-radius: 4px 2px 5px 3px;
  background: var(--lime);
  transform: rotate(-2.5deg) scaleX(0);
  transform-origin: left center;
  clip-path: inset(0);
  animation: forward-paint-and-erase 3.2s cubic-bezier(.22,.75,.25,1) 1s both;
}

/* Tiny off-white eraser with a darker edge and soft shadow. */
.forward-eraser {
  position: absolute;
  z-index: 3;
  left: calc(100% + 35vw);
  bottom: 6%;
  width: 17px;
  height: 9px;
  border: 1px solid #d2cec3;
  border-radius: 2px;
  background: #fffdf8;
  box-shadow: 1px 2px 0 rgb(23 24 21 / 16%);
  opacity: 0;
  pointer-events: none;
  transform: rotate(-8deg);
  animation: forward-eraser-travel 3.2s ease-in-out 1s both;
}

@keyframes forward-paint-and-erase {
  0%, 8% {
    transform: rotate(-2.5deg) scaleX(0);
    clip-path: inset(0);
  }
  34%, 45% {
    transform: rotate(-2.5deg) scaleX(1);
    clip-path: inset(0);
  }
  /* Erase from the far-right overshoot back toward the word. */
  72% {
    transform: rotate(-2.5deg) scaleX(1);
    clip-path: inset(0 100% 0 0);
  }
  73%, 100% {
    transform: rotate(-2.5deg) scaleX(1);
    clip-path: inset(0 100% 0 0);
  }
}

@keyframes forward-eraser-travel {
  0%, 42% {
    left: calc(100% + 35vw);
    opacity: 0;
  }
  46% {
    left: calc(100% + 35vw);
    opacity: 1;
  }
  70% {
    left: 96%;
    opacity: 1;
  }
  75%, 100% {
    left: 96%;
    opacity: 0;
  }
}

@media (max-width: 760px) {
  .forward-paint-mistake {
    width: calc(100% + 40vw);
  }
  .forward-eraser {
    left: calc(100% + 32vw);
  }
  @keyframes forward-eraser-travel {
    0%, 42% {
      left: calc(100% + 32vw);
      opacity: 0;
    }
    46% {
      left: calc(100% + 32vw);
      opacity: 1;
    }
    70% {
      left: 96%;
      opacity: 1;
    }
    75%, 100% {
      left: 96%;
      opacity: 0;
    }
  }
}

@media (prefers-reduced-motion: reduce) {
  .forward-paint-mistake,
  .forward-eraser {
    animation: none !important;
    display: none !important;
  }
}

/* ===== FIX HEADLINE ALIGNMENT ===== */

/* Keep the highlighted word on its own line, as originally designed. */
.hero h1 .headline-highlight {
  display: table;
  position: relative;
  width: fit-content;
  max-width: 100%;
  margin-top: 0;
  white-space: nowrap;
  isolation: isolate;
}

/* Keep the paint layers aligned to the word, not the whole heading. */
.hero h1 .headline-highlight::before,
.hero h1 .headline-highlight::after {
  pointer-events: none;
}

/* Keep temporary paint and eraser positioned relative to forward. */
.hero h1 .headline-highlight .forward-paint-mistake,
.hero h1 .headline-highlight .forward-eraser {
  position: absolute;
}

/* Avoid clipping the italic letters or their descenders. */
.hero h1 {
  overflow: visible;
}

@media (max-width: 760px) {
  .hero h1 .headline-highlight {
    margin-left: 0;
    white-space: nowrap;
  }
}
